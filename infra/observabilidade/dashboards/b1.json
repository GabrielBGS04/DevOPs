{
  "uid": "b1-operacao",
  "title": "B1 | Falhas, recuperacao e operacao",
  "tags": [
    "B1",
    "laboratorio"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Core disponivel (scrape)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-b1"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"core\"}",
          "legendFormat": "Core disponivel (scrape)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "Falhas acumuladas da IA",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-b1"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "b1_ia_falhas_total",
          "legendFormat": "Falhas acumuladas da IA"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
