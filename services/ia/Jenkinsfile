pipeline {
    agent { label 'docker' }
    options { timestamps(); disableConcurrentBuilds() }
    stages {
        stage('Testes') {
            steps {
                script {
                    if (isUnix()) { sh 'docker build --target test services/ia' }
                    else { bat 'docker build --target test services/ia' }
                }
            }
        }
        stage('Imagem') {
            steps {
                script {
                    env.B1_IMAGE_TAG = env.GIT_COMMIT.take(12)
                    if (isUnix()) { sh 'docker build --target runtime -t b1-ia:$B1_IMAGE_TAG services/ia' }
                    else { bat 'docker build --target runtime -t b1-ia:%B1_IMAGE_TAG% services/ia' }
                }
            }
        }
        stage('Atualizar IA local') {
            steps {
                script {
                    if (isUnix()) { sh 'docker compose --profile ia up -d --no-deps --no-build ia' }
                    else { bat 'docker compose --profile ia up -d --no-deps --no-build ia' }
                }
            }
        }
    }
}
