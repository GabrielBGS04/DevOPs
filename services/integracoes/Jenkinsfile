pipeline {
    agent { label 'docker' }
    options { timestamps(); disableConcurrentBuilds() }
    stages {
        stage('Testes') {
            steps {
                script {
                    if (isUnix()) { sh 'docker build --target test services/integracoes' }
                    else { bat 'docker build --target test services/integracoes' }
                }
            }
        }
        stage('Imagem') {
            steps {
                script {
                    env.B1_IMAGE_TAG = env.GIT_COMMIT.take(12)
                    if (isUnix()) { sh 'docker build --target runtime -t b1-integracoes:$B1_IMAGE_TAG services/integracoes' }
                    else { bat 'docker build --target runtime -t b1-integracoes:%B1_IMAGE_TAG% services/integracoes' }
                }
            }
        }
        stage('Atualizar integrações locais') {
            steps {
                script {
                    if (isUnix()) { sh 'docker compose --profile integracoes up -d --no-deps --no-build integracoes' }
                    else { bat 'docker compose --profile integracoes up -d --no-deps --no-build integracoes' }
                }
            }
        }
    }
}
